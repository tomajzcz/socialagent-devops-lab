# socialagent-devops-lab - local environment variables
# Load into the current shell (from repo root):  source .env
# Template: copy to .env and fill in your values.

# --- Hetzner Cloud ---
export HCLOUD_TOKEN="$(security find-generic-password -a "$USER" -s socialagent-lab-hcloud -w)"

# --- Terraform (TF_VAR_x = var.x in variables.tf; terraform.tfvars takes precedence) ---
export TF_VAR_ssh_allowed_cidr="XX.XX.XX.XX/32"   # your public IPv4
export TF_VAR_location="fsn1"
export TF_VAR_server_type="cax21"
export TF_VAR_ssh_public_key_path="$HOME/.ssh/id_rsa.pub"

# --- Kubernetes (kubeconfig outside the repo, contains the cluster admin certificate) ---
export KUBECONFIG="$HOME/.kube/socialagent-lab.yaml"

# --- Containers and exporter ---
export EXPORTER_IMAGE="ghcr.io/tomajzcz/socialagent-exporter"
export DOCKER_DEFAULT_PLATFORM="linux/arm64"
export TARGET_URL="https://socialagent.cz/api/health"

# --- Sanity check ---
if [ -z "$HCLOUD_TOKEN" ]; then
  echo "Warning: HCLOUD_TOKEN is empty, check the Keychain." >&2
fi

# --- Ansible ---
export LAB_SERVER_IP="<server_ipv4 from terraform output>"
