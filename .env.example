# socialagent-devops-lab - lokální proměnné prostředí
# Načtení do aktuálního terminálu (z kořene repa):  source .env
# Soubor je v .gitignore. Token v něm není, načítá se z macOS Keychainu.

# --- Hetzner Cloud ---
export HCLOUD_TOKEN="$(security find-generic-password -a "$USER" -s socialagent-lab-hcloud -w)"

# --- Terraform (TF_VAR_x = var.x ve variables.tf; terraform.tfvars má přednost) ---
export TF_VAR_ssh_allowed_cidr="193.179.119.43/32"   # tvoje IPv4, ověřeno 2026-11-25
export TF_VAR_location="fsn1"
export TF_VAR_server_type="cax21"
export TF_VAR_ssh_public_key_path="$HOME/.ssh/id_rsa.pub"

# --- Kubernetes (kubeconfig mimo repo, obsahuje admin certifikát) ---
export KUBECONFIG="$HOME/.kube/socialagent-lab.yaml"

# --- Kontejnery a exporter ---
export EXPORTER_IMAGE="ghcr.io/tomajzcz/socialagent-exporter"
export DOCKER_DEFAULT_PLATFORM="linux/arm64"
export TARGET_URL="https://socialagent.cz/api/health"

# --- Kontrola ---
if [ -z "$HCLOUD_TOKEN" ]; then
  echo "Pozor: HCLOUD_TOKEN je prázdný, zkontroluj Keychain." >&2
fi
