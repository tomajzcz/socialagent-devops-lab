# Secrets and local config
.env
.env.*
!.env.example

# Terraform
# (.terraform.lock.hcl SHOULD be committed - it pins provider versions)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
tfplan
*.tfplan

# Kubernetes and SSH keys
kubeconfig*
*.kubeconfig
*.pem
*.key
id_rsa*
id_ed25519*

# Ansible (encrypted vault files may be committed, their password may not)
*.retry
.vault_pass*
# Collections cache created by ansible-lint
.ansible/

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store
